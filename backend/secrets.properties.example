# Copiá este archivo como "secrets.properties" (en esta misma carpeta) y poné tus credenciales
# de PRUEBA de Mercado Pago. secrets.properties no se sube a git.
#
# Dónde se consiguen: https://www.mercadopago.com.uy/developers/panel/app
#   -> tu aplicación -> Credenciales de prueba -> Access Token

payments.mercadopago.access-token=

# Opcional: correo de un usuario de prueba "comprador" de Mercado Pago, si los pagos de prueba
# no se aprueban con el correo del turista.
payments.mercadopago.test-payer-email=
